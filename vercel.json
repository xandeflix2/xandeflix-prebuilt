{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run site:build",
  "outputDirectory": "tmp/c154-web-production/site",
  "rewrites": [
    { "source": "/", "destination": "/manager.html" },
    { "source": "/admin", "destination": "/manager.html" },
    { "source": "/master", "destination": "/manager.html" },
    { "source": "/manager", "destination": "/manager.html" },
    { "source": "/manager-reset-password", "destination": "/manager.html" },
    { "source": "/app", "destination": "/app/app.html" },
    { "source": "/app/", "destination": "/app/app.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
    ] }
  ]
}
