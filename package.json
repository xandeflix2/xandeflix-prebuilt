{
  "name": "xandeflix-prebuilt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run c11:new-device:lock",
    "build": "tsc && vite build",
    "c11:new-device:lock": "node scripts/test-c11-new-device-activation-lock.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "contract:check": "node scripts/validate-data-contract.mjs",
    "ingestion:synthetic": "node scripts/run-ingestion-pipeline.mjs",
    "ingestion:negative": "node scripts/run-ingestion-pipeline.mjs --negative",
    "provisioning:build": "node scripts/build-provisioning-package.mjs",
    "provisioning:check": "node scripts/validate-provisioning-package.mjs",
    "bootstrap:check": "node scripts/validate-device-bootstrap.mjs",
    "catalog-ui:check": "node scripts/validate-catalog-ui.mjs",
    "search:index:build": "node scripts/build-prebuilt-search-index.mjs",
    "search:check": "node scripts/validate-prebuilt-search.mjs",
    "search:benchmark": "node scripts/benchmark-prebuilt-search-scale.mjs",
    "search:compact:benchmark": "node scripts/benchmark-search-compact-r2.mjs",
    "search:compact:r3": "node scripts/benchmark-search-compact-r3.mjs",
    "search:compact:r4": "node scripts/run-firestick-compact-v2-benchmark.mjs",
    "search:compact:r5": "node scripts/benchmark-search-compact-r5.mjs",
    "playback:check": "node scripts/validate-direct-playback.mjs",
    "update:check": "node scripts/validate-incremental-update.mjs",
    "update:benchmark": "node scripts/benchmark-incremental-update-scale.mjs",
    "security:check": "node scripts/validate-security-recovery.mjs",
    "source:check": "node scripts/test-real-source-adapter.mjs",
    "r7b:check": "node scripts/test-dual-mode-authorization.mjs",
    "c11:self-service-delivery:check": "node scripts/test-c11-self-service-runtime-delivery-fix.mjs",
    "c11:vod-direct-stream:check": "node scripts/test-c11-vod-direct-stream-contract.mjs",
    "c11:playback-session:check": "node scripts/test-c11-playback-session-c9-runtime-wiring.mjs",
    "r7c:check": "node scripts/test-real-source-import-and-live.mjs",
    "r2c:check": "node scripts/test-r2c-source-authority.mjs",
    "r2f8p:check": "node scripts/test-r2f8-persistent-reactivation-handle.mjs",
    "r2f8s:check": "node scripts/test-r2f8s-reactivation-request-lifecycle.mjs",
    "r2f8t:check": "node scripts/test-r2f8t-stale-reactivation-expiry.mjs",
    "r2d-a1:check": "node scripts/test-r2d-a1-source-identity-compatibility.mjs",
    "r2d-a3a:check": "node scripts/test-r2d-a3a-manager-auth-remote-write.mjs",
    "r2f8r:check": "node scripts/test-r2f8r-authorized-device-reactivation.mjs",
    "r2f8:series-page:check": "node scripts/test-r2f8-series-page-typed-scope.mjs",
    "r2f8:series-category-provenance:check": "node scripts/test-r2f8-series-category-provenance.mjs",
    "r2f8:catalog-semantics:check": "node scripts/test-r2f8-real-catalog-semantics.mjs",
    "r2f8:source-profile:check": "node scripts/test-r2f8-explicit-source-profile-canais-live.mjs",
    "r2f8:manager-reactivation-ui:check": "node scripts/test-r2f8-manager-reactivation-approval-ui.mjs",
    "c11:device-import-memory-fix:check": "node scripts/test-c11-device-import-pre-staging-memory-fix.mjs",
    "c11:bounded-memory-import:check": "node scripts/test-c11-bounded-memory-import.mjs",
    "c11:post-gate-a:check": "node scripts/test-c11-post-gate-a-functional-density.mjs",
    "c11:profile-live-fix:check": "node scripts/test-c11-profile-live-snapshot-fix.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/browser": "7.0.5",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.1.8",
    "@supabase/supabase-js": "2.116.0",
    "buffer": "^6.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jszip": "^3.10.1",
    "typescript": "~5.6.3",
    "vite": "^6.0.0"
  }
}
