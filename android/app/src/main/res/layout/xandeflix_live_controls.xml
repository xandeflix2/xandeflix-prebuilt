<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@id/exo_controls_background"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/player_controls_scrim"
    android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:paddingRight="64dp">
        <Button android:id="@+id/live_back" android:layout_width="56dp" android:layout_height="48dp" android:text="←" android:textSize="24sp" android:contentDescription="Sair da tela cheia" android:background="@drawable/player_control_focus" android:textColor="#FFFFFF"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginLeft="12dp">
            <TextView android:id="@+id/live_player_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="18sp" android:textStyle="bold" android:textColor="#FFFFFF" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/live_player_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#DDDDDD" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="72dp" android:layout_gravity="center" android:gravity="center_vertical">
        <Button android:id="@+id/live_previous" android:layout_width="88dp" android:layout_height="56dp" android:layout_marginRight="20dp" android:text="❮ Canal" android:textAllCaps="false" android:textSize="14sp" android:contentDescription="Canal anterior" android:background="@drawable/player_control_focus" android:textColor="#FFFFFF"/>
        <ImageButton android:id="@id/exo_play_pause" android:layout_width="72dp" android:layout_height="72dp" android:background="@drawable/player_control_focus" android:padding="14dp" android:src="@drawable/exo_styled_controls_play" android:contentDescription="Reproduzir ou pausar"/>
        <Button android:id="@+id/live_next" android:layout_width="88dp" android:layout_height="56dp" android:layout_marginLeft="20dp" android:text="Canal ❯" android:textAllCaps="false" android:textSize="14sp" android:contentDescription="Próximo canal" android:background="@drawable/player_control_focus" android:textColor="#FFFFFF"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical">
        <TextView android:id="@+id/live_player_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#FFFFFF" android:textSize="14sp" android:maxLines="2" android:layout_marginBottom="8dp"/>
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="56dp" android:fillViewport="true" android:scrollbars="none">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center">
                <Button android:id="@+id/live_channels" android:layout_width="104dp" android:layout_height="48dp" android:text="Canais" android:textSize="13sp" android:textAllCaps="false" android:background="@drawable/player_control_focus" android:textColor="#FFFFFF"/>
                <Button android:id="@+id/live_categories" android:layout_width="104dp" android:layout_height="48dp" android:text="Categorias" android:textSize="13sp" android:textAllCaps="false" android:background="@drawable/player_control_focus" android:textColor="#FFFFFF"/>
                <Button android:id="@+id/live_guide" android:layout_width="88dp" android:layout_height="48dp" android:text="Guia" android:textSize="13sp" android:textAllCaps="false" android:background="@drawable/player_control_focus" android:textColor="#FFFFFF"/>
                <Button android:id="@+id/live_favorite" android:layout_width="128dp" android:layout_height="48dp" android:text="☆ Favoritar" android:textSize="13sp" android:textAllCaps="false" android:background="@drawable/player_control_focus" android:textColor="#FFFFFF"/>
                <Button android:id="@+id/live_favorites" android:layout_width="104dp" android:layout_height="48dp" android:text="Favoritos" android:textSize="13sp" android:textAllCaps="false" android:background="@drawable/player_control_focus" android:textColor="#FFFFFF"/>
                <Button android:id="@+id/live_tracks" android:layout_width="104dp" android:layout_height="48dp" android:text="Áudio/legendas" android:textSize="12sp" android:textAllCaps="false" android:background="@drawable/player_control_focus" android:textColor="#FFFFFF"/>
                <Button android:id="@+id/live_resize" android:layout_width="104dp" android:layout_height="48dp" android:text="Ajustar tela" android:textSize="13sp" android:textAllCaps="false" android:background="@drawable/player_control_focus" android:textColor="#FFFFFF"/>
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</FrameLayout>
