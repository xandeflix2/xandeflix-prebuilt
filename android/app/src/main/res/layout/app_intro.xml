<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000" android:clickable="true" android:focusable="true"
    android:focusableInTouchMode="true">
    <!-- Error fallback only; normal launch presents the video without a static logo. -->
    <ImageView android:id="@+id/intro_still" android:layout_width="match_parent"
        android:layout_height="match_parent" android:scaleType="fitCenter"
        android:visibility="gone" android:contentDescription="@string/app_name" />
</FrameLayout>
