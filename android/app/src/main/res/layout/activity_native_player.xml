<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/native_player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="true"
        app:controller_layout_id="@layout/xandeflix_player_controls"
        app:show_buffering="always"
        app:resize_mode="fit" />

    <TextView
        android:id="@+id/native_seek_feedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginLeft="48dp"
        android:layout_marginRight="48dp"
        android:padding="12dp"
        android:background="#B31C1E26"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:clickable="false"
        android:focusable="false"
        android:accessibilityLiveRegion="polite"
        android:visibility="gone" />

    <!-- Next Episode Credits Countdown Overlay -->
    <LinearLayout
        android:id="@+id/next_episode_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginRight="36dp"
        android:layout_marginBottom="36dp"
        android:orientation="vertical"
        android:background="@drawable/next_episode_card_bg"
        android:paddingLeft="20dp"
        android:paddingTop="16dp"
        android:paddingRight="20dp"
        android:paddingBottom="16dp"
        android:elevation="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/next_episode_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Próximo episódio em 5s"
            android:textSize="12sp"
            android:textColor="#94A3B8"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/next_episode_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:maxWidth="320dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="T1:E2 · Próximo Episódio"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/next_episode_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginBottom="12dp"
            android:max="5000"
            android:progress="5000"
            android:progressDrawable="@drawable/next_episode_progress_drawable" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/next_episode_btn_play"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minHeight="44dp"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:background="@drawable/player_control_focus"
                android:text="Assistir agora (5s) ▶"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:focusable="true" />

            <Button
                android:id="@+id/next_episode_btn_cancel"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minHeight="44dp"
                android:layout_marginLeft="10dp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:background="@drawable/player_control_focus"
                android:text="Cancelar"
                android:textAllCaps="false"
                android:textColor="#E2E8F0"
                android:textSize="13sp"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Next Episode Loading Transition Overlay -->
    <LinearLayout
        android:id="@+id/episode_transition_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6000000"
        android:gravity="center"
        android:orientation="vertical"
        android:elevation="20dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/episode_transition_logo"
            android:layout_width="180dp"
            android:layout_height="80dp"
            android:scaleType="fitCenter"
            android:src="@drawable/xandeflix_tv_banner"
            android:contentDescription="Xandeflix" />

        <ProgressBar
            android:id="@+id/episode_transition_spinner"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:indeterminate="true"
            android:indeterminateTint="#E50914" />

        <TextView
            android:id="@+id/episode_transition_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#E2E8F0"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="Carregando próximo episódio..." />
    </LinearLayout>

</FrameLayout>
