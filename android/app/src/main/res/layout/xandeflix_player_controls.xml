<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/player_controls_scrim"
    android:paddingLeft="20dp" android:paddingRight="20dp" android:paddingTop="12dp" android:paddingBottom="12dp">
    <LinearLayout android:id="@+id/player_top" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
        <Button android:id="@+id/player_back" android:layout_width="64dp" android:layout_height="48dp" android:text="←" android:textSize="26sp" android:textColor="#FFFFFF" android:background="@drawable/player_control_focus" android:contentDescription="Voltar"/>
        <TextView android:id="@+id/player_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginLeft="16dp" android:layout_marginRight="16dp" android:textSize="17sp" android:textStyle="bold" android:textColor="#FFFFFF" android:maxLines="2" android:ellipsize="end"/>
        <FrameLayout android:id="@+id/player_cast_slot" android:layout_width="48dp" android:layout_height="48dp"/>
        <Button android:id="@+id/player_lock" android:layout_width="88dp" android:layout_height="48dp" android:text="Bloquear" android:textSize="12sp" android:textAllCaps="false" android:textColor="#FFFFFF" android:background="@drawable/player_control_focus"/>
    </LinearLayout>
    <FrameLayout android:id="@+id/player_brightness" android:layout_width="48dp" android:layout_height="150dp" android:layout_gravity="center_vertical|start" android:contentDescription="Brilho da tela">
        <TextView android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center" android:text="☀" android:textSize="24sp" android:textColor="#FFFFFF"/>
        <SeekBar android:id="@+id/player_brightness_seek" android:layout_width="120dp" android:layout_height="48dp" android:layout_gravity="center" android:rotation="270" android:max="100" android:progress="50" android:progressTint="#FFFFFF" android:thumbTint="#FF263A" android:contentDescription="Ajustar brilho"/>
    </FrameLayout>
    <LinearLayout android:id="@+id/player_center" android:layout_width="wrap_content" android:layout_height="88dp" android:layout_gravity="center" android:gravity="center_vertical">
        <FrameLayout android:layout_width="72dp" android:layout_height="72dp" android:layout_marginLeft="24dp" android:layout_marginRight="24dp">
            <ImageButton android:id="@id/exo_rew" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingBottom="16dp" android:background="@drawable/player_control_focus" android:src="@drawable/exo_styled_controls_rewind" android:contentDescription="Voltar 10 segundos"/>
            <TextView android:layout_width="match_parent" android:layout_height="20dp" android:layout_gravity="bottom" android:layout_marginBottom="4dp" android:gravity="center" android:text="−10s" android:textSize="12sp" android:textColor="#FFFFFF" android:importantForAccessibility="no"/>
        </FrameLayout>
        <ImageButton android:id="@id/exo_play_pause" android:layout_width="88dp" android:layout_height="88dp" android:padding="16dp" android:background="@drawable/player_control_focus" android:src="@drawable/exo_styled_controls_play" android:contentDescription="Reproduzir ou pausar"/>
        <FrameLayout android:layout_width="72dp" android:layout_height="72dp" android:layout_marginLeft="24dp" android:layout_marginRight="24dp">
            <ImageButton android:id="@id/exo_ffwd" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingBottom="16dp" android:background="@drawable/player_control_focus" android:src="@drawable/exo_styled_controls_fastforward" android:contentDescription="Avançar 10 segundos"/>
            <TextView android:layout_width="match_parent" android:layout_height="20dp" android:layout_gravity="bottom" android:layout_marginBottom="4dp" android:gravity="center" android:text="+10s" android:textSize="12sp" android:textColor="#FFFFFF" android:importantForAccessibility="no"/>
        </FrameLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/player_bottom" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical">
        <TextView android:id="@+id/player_transition" android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center" android:text="Preparando o próximo episódio…" android:textSize="14sp" android:textColor="#FFFFFF" android:visibility="gone"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical">
            <TextView android:id="@id/exo_position" android:layout_width="60dp" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#FFFFFF" android:gravity="center"/>
            <androidx.media3.ui.DefaultTimeBar android:id="@id/exo_progress" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:focusable="true" android:contentDescription="Posição do vídeo" app:played_color="#FF263A" app:scrubber_color="#FF263A" app:buffered_color="#80FFFFFF" app:unplayed_color="#40FFFFFF" app:bar_height="3dp" app:scrubber_enabled_size="14dp" app:scrubber_dragged_size="18dp"/>
            <TextView android:id="@id/exo_duration" android:layout_width="60dp" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#FFFFFF" android:gravity="center"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/player_actions" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center">
            <Button android:id="@+id/player_resize" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_marginLeft="3dp" android:layout_marginRight="3dp" android:text="Preencher tela" android:textSize="12sp" android:textAllCaps="false" android:textColor="#FFFFFF" android:background="@drawable/player_control_focus"/>
            <Button android:id="@+id/player_speed" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_marginLeft="3dp" android:layout_marginRight="3dp" android:text="Velocidade (1x)" android:textSize="12sp" android:textAllCaps="false" android:textColor="#FFFFFF" android:background="@drawable/player_control_focus"/>
            <Button android:id="@+id/player_episodes" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_marginLeft="3dp" android:layout_marginRight="3dp" android:text="Episódios" android:textSize="12sp" android:textAllCaps="false" android:textColor="#FFFFFF" android:background="@drawable/player_control_focus"/>
            <Button android:id="@+id/player_tracks" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_marginLeft="3dp" android:layout_marginRight="3dp" android:text="Áudio e legendas" android:textSize="12sp" android:textAllCaps="false" android:textColor="#FFFFFF" android:background="@drawable/player_control_focus"/>
            <Button android:id="@+id/player_next" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_marginLeft="3dp" android:layout_marginRight="3dp" android:text="Próximo episódio ▷" android:textSize="12sp" android:textAllCaps="false" android:textColor="#FFFFFF" android:background="@drawable/player_control_focus"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
