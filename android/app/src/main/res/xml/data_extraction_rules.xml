        <exclude domain="file" path="app_installation.json" />
        <exclude domain="file" path="device_activation_key.json" />
        <exclude domain="file" path="device_activation.json" />
        <exclude domain="file" path="pending_device_token.json" />
        <exclude domain="root" path="app_webview" />
    </device-transfer>
</data-extraction-rules>
