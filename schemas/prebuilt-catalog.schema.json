{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xandeflix.com/schemas/prebuilt-catalog.v1.json",
  "title": "PrebuiltCatalog",
  "description": "Contrato canonico machine-readable para o catalogo PREBUILT (Xandeflix Prebuilt v1)",
  "type": "object",
  "required": [
    "metadata",
    "categories",
    "genres",
    "movies",
    "series",
    "seasons",
    "episodes",
    "streams",
    "artworks"
  ],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "$ref": "#/$defs/SnapshotMetadata"
    },
    "categories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Category"
      }
    },
    "genres": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Genre"
      }
    },
    "movies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Movie"
      }
    },
    "series": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Series"
      }
    },
    "seasons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Season"
      }
    },
    "episodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Episode"
      }
    },
    "streams": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/StreamRef"
      }
    },
    "artworks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ArtworkRef"
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "EntityId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "SafeUri": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*://[^/]*:[^/]*@)https?://[A-Za-z0-9_.:~%#?&=/+-]+$"
    },
    "ContentKind": {
      "type": "string",
      "enum": ["movie", "series", "episode"]
    },
    "CategoryContentKind": {
      "type": "string",
      "enum": ["movie", "series"]
    },
    "ArtworkKind": {
      "type": "string",
      "enum": ["poster", "backdrop", "thumbnail", "logo"]
    },
    "ExternalIds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tmdbId": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "integer", "minimum": 1 }
          ]
        },
        "imdbId": {
          "type": "string",
          "pattern": "^ev\\d{7}\\/\\d{4}(-\\d)?$|^(ch|co|ev|nm|tt)\\d{7,10}$"
        },
        "sourceItemId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "SnapshotCounts": {
      "type": "object",
      "required": [
        "movies",
        "series",
        "seasons",
        "episodes",
        "categories",
        "genres",
        "streams",
        "artworks"
      ],
      "additionalProperties": false,
      "properties": {
        "movies": { "type": "integer", "minimum": 0 },
        "series": { "type": "integer", "minimum": 0 },
        "seasons": { "type": "integer", "minimum": 0 },
        "episodes": { "type": "integer", "minimum": 0 },
        "categories": { "type": "integer", "minimum": 0 },
        "genres": { "type": "integer", "minimum": 0 },
        "streams": { "type": "integer", "minimum": 0 },
        "artworks": { "type": "integer", "minimum": 0 }
      }
    },
    "SnapshotMetadata": {
      "type": "object",
      "required": [
        "schemaVersion",
        "catalogVersion",
        "snapshotId",
        "generatedAt",
        "counts"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "catalogVersion": {
          "type": "string",
          "minLength": 1
        },
        "snapshotId": {
          "type": "string",
          "minLength": 1
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "counts": {
          "$ref": "#/$defs/SnapshotCounts"
        },
        "generator": {
          "type": "string"
        }
      }
    },
    "Category": {
      "type": "object",
      "required": ["id", "name", "contentKinds"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/EntityId" },
        "name": { "type": "string", "minLength": 1 },
        "contentKinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/CategoryContentKind"
          }
        }
      }
    },
    "Genre": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/EntityId" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "ArtworkRef": {
      "type": "object",
      "required": ["id", "kind", "uri"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/EntityId" },
        "kind": { "$ref": "#/$defs/ArtworkKind" },
        "uri": { "$ref": "#/$defs/SafeUri" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "mimeType": { "type": "string", "minLength": 3 }
      }
    },
    "StreamRef": {
      "type": "object",
      "required": ["id", "sourceItemId", "contentKind"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/EntityId" },
        "sourceItemId": { "type": "string", "minLength": 1 },
        "contentKind": { "$ref": "#/$defs/ContentKind" },
        "containerExtension": { "type": "string", "minLength": 1 },
        "qualityLabel": { "type": "string", "minLength": 1 }
      }
    },
    "Movie": {
      "type": "object",
      "required": [
        "id",
        "title",
        "genreIds",
        "categoryIds",
        "artworkIds",
        "streamIds"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/EntityId" },
        "title": { "type": "string", "minLength": 1 },
        "originalTitle": { "type": "string" },
        "year": { "type": "integer", "minimum": 1888, "maximum": 2100 },
        "overview": { "type": "string" },
        "durationSeconds": { "type": "integer", "minimum": 0 },
        "genreIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/EntityId" }
        },
        "categoryIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/EntityId" }
        },
        "artworkIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/EntityId" }
        },
        "streamIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/EntityId" }
        },
        "externalIds": { "$ref": "#/$defs/ExternalIds" }
      }
    },
    "Series": {
      "type": "object",
      "required": [
        "id",
        "title",
        "genreIds",
        "categoryIds",
        "artworkIds",
        "seasonIds"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/EntityId" },
        "title": { "type": "string", "minLength": 1 },
        "originalTitle": { "type": "string" },
        "year": { "type": "integer", "minimum": 1888, "maximum": 2100 },
        "overview": { "type": "string" },
        "genreIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/EntityId" }
        },
        "categoryIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/EntityId" }
        },
        "artworkIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/EntityId" }
        },
        "seasonIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/EntityId" }
        },
        "externalIds": { "$ref": "#/$defs/ExternalIds" }
      }
    },
    "Season": {
      "type": "object",
      "required": [
        "id",
        "seriesId",
        "seasonNumber",
        "episodeIds"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/EntityId" },
        "seriesId": { "$ref": "#/$defs/EntityId" },
        "seasonNumber": { "type": "integer", "minimum": 0 },
        "title": { "type": "string" },
        "episodeIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/EntityId" }
        },
        "artworkIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/EntityId" }
        }
      }
    },
    "Episode": {
      "type": "object",
      "required": [
        "id",
        "seriesId",
        "seasonId",
        "episodeNumber",
        "title",
        "artworkIds",
        "streamIds"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/EntityId" },
        "seriesId": { "$ref": "#/$defs/EntityId" },
        "seasonId": { "$ref": "#/$defs/EntityId" },
        "episodeNumber": { "type": "integer", "minimum": 0 },
        "title": { "type": "string", "minLength": 1 },
        "overview": { "type": "string" },
        "durationSeconds": { "type": "integer", "minimum": 0 },
        "artworkIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/EntityId" }
        },
        "streamIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/EntityId" }
        },
        "externalIds": { "$ref": "#/$defs/ExternalIds" }
      }
    }
  }
}
